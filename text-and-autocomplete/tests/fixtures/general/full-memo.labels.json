{
  "MEMORANDUM": ["heading", "framing"],
  "TO: Dana Whitfield, Supervising Partner": ["other", "framing"],
  "FROM: Associate": ["other", "framing"],
  "DATE: October 1, 2026": ["other", "framing"],
  "RE: Marisol Alvarez; Title VII retaliation claim against Brightwater Logistics, Inc.": [
